            "uid": "PFEA697777BCBACF7"
          },
          "query": "from(bucket: \"moodle_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"moodle_traffic\")\n  |> filter(fn: (r) => r._field == \"request_count\" or r._field == \"unique_users\" or r._field == \"error_count\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
