      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "PFEA697777BCBACF7"
          },
          "query": "traffic = from(bucket: \"moodle_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"moodle_traffic\" and r._field == \"request_count\")\n  |> keep(columns: [\"_time\",\"_value\"])\n  |> rename(columns: {_value: \"request_count\"})\n  |> map(fn: (r) => ({r with request_count: float(v: r.request_count)}))\n\nscores = from(bucket: \"moodle_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly_scores\")\n  |> filter(fn: (r) => r._field == \"arima_anomaly\" or r._field == \"lstm_anomaly\" or r._field == \"if_anomaly\" or r._field == \"is_anomaly\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n\nperWindow = join(tables: {t: traffic, s: scores}, on: [\"_time\"])\n  |> map(fn: (r) => {\n        actual = if r.request_count > 50.0 then 1.0 else 0.0\n        arimaP = float(v: r.arima_anomaly)\n        lstmP = float(v: r.lstm_anomaly)\n        ifP = float(v: r.if_anomaly)\n        contP = float(v: r.is_anomaly)\n        binScore = (ifP * 1.0 + arimaP * 0.8 + lstmP * 1.2) / 3.0\n        binP = if binScore >= 0.5 then 1.0 else 0.0\n        return {\n          _time: r._time,\n          actual: actual,\n          arima: arimaP, lstm: lstmP, iforest: ifP, fbin: binP, fcont: contP\n        }\n     })\n\nreduceMetrics = (get, nombre) => perWindow\n  |> reduce(\n      identity: {tp: 0.0, fp: 0.0, fnv: 0.0, tn: 0.0},\n      fn: (r, accumulator) => {\n        pred = get(r: r)\n        return {\n          tp: accumulator.tp + (if pred == 1.0 and r.actual == 1.0 then 1.0 else 0.0),\n          fp: accumulator.fp + (if pred == 1.0 and r.actual == 0.0 then 1.0 else 0.0),\n          fnv: accumulator.fnv + (if pred == 0.0 and r.actual == 1.0 then 1.0 else 0.0),\n          tn: accumulator.tn + (if pred == 0.0 and r.actual == 0.0 then 1.0 else 0.0),\n        }\n      }\n  )\n  |> map(fn: (r) => {\n        precision = if (r.tp + r.fp) > 0.0 then r.tp / (r.tp + r.fp) else 0.0\n        recall = if (r.tp + r.fnv) > 0.0 then r.tp / (r.tp + r.fnv) else 0.0\n        f1 = if (precision + recall) > 0.0 then 2.0 * precision * recall / (precision + recall) else 0.0\n        return {modelo: nombre, tp: r.tp, fp: r.fp, fn: r.fnv, tn: r.tn, precision: precision, recall: recall, f1: f1}\n     })\n\nt_arima = reduceMetrics(get: (r) => r.arima, nombre: \"ARIMA\")\nt_lstm  = reduceMetrics(get: (r) => r.lstm, nombre: \"LSTM Autoencoder\")\nt_if    = reduceMetrics(get: (r) => r.iforest, nombre: \"Isolation Forest\")\nt_fbin  = reduceMetrics(get: (r) => r.fbin, nombre: \"Fusión ponderada binaria\")\nt_fcon  = reduceMetrics(get: (r) => r.fcont, nombre: \"Fusión por score continuo\")\n\ncombined = union(tables: [t_arima, t_lstm, t_if, t_fbin, t_fcon])\n\ncombined\n  |> keep(columns: [\"modelo\",\"precision\",\"recall\",\"f1\",\"tp\",\"tn\",\"fp\",\"fn\"])\n  |> yield(name: \"tabla12_table\")\n",
          "refId": "A"
        }
      ],
