      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "PFEA697777BCBACF7"
          },
          "query": "traffic = from(bucket: \"moodle_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"moodle_traffic\" and r._field == \"request_count\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\",\"_value\"])\n  |> rename(columns: {_value: \"request_count\"})\n\nscores = from(bucket: \"moodle_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly_scores\")\n  |> filter(fn: (r) => r._field == \"final_score\" or r._field == \"if_score\" or r._field == \"lstm_recon_error\" or r._field == \"lstm_threshold\" or r._field == \"arima_predicted\" or r._field == \"arima_upper\" or r._field == \"arima_lower\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n\njoin(tables: {t: traffic, s: scores}, on: [\"_time\"])\n  |> map(fn: (r) => {\n        half = if exists r.arima_upper and exists r.arima_lower and (r.arima_upper - r.arima_lower)/2.0 > 0.000001 then (r.arima_upper - r.arima_lower)/2.0 else 0.000001\n        dist = if exists r.arima_predicted then (if (r.request_count - r.arima_predicted) < 0.0 then -(r.request_count - r.arima_predicted) else (r.request_count - r.arima_predicted)) else 0.0\n        araw = (dist / half) / 2.0\n        aScore = if araw > 1.0 then 1.0 else araw\n        lraw = if exists r.lstm_recon_error and exists r.lstm_threshold and r.lstm_threshold > 0.0 then (r.lstm_recon_error / r.lstm_threshold) / 2.0 else 0.0\n        lScore = if lraw > 1.0 then 1.0 else lraw\n        return {\n          _time: r._time,\n          arima_score: aScore,\n          lstm_score: lScore,\n          if_score: if exists r.if_score then r.if_score else 0.0,\n          final_score: if exists r.final_score then r.final_score else 0.0\n        }\n     })\n  |> yield(name: \"scores\")",
          "refId": "A"
        }
      ],
      "title": "Evolución de scores de anomalía (normalizados 0-1, comparables entre modelos)",
      "type": "timeseries"
    },
